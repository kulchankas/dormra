# Supabase — required for auth, database, and client-side reads
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — required for cron/scraper writes and alert dispatch (server-only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron endpoint auth — set the same value in cron-job.org as Bearer token
CRON_SECRET=generate-a-long-random-string

# Resend — required for availability alert emails
RESEND_API_KEY=re_your_api_key

# Optional — after verifying domain in Resend (defaults to onboarding@resend.dev sandbox)
RESEND_FROM=Dormra <alerts@dormra.eu>

# Public site URL — used for canonical links, hreflang, and email URLs
NEXT_PUBLIC_SITE_URL=https://dormra.eu

# Admin dashboard — comma-separated emails allowed to access /admin
ADMIN_EMAILS=you@example.com

# Supabase — required for auth, database, and client-side reads
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — required for cron/scraper writes and alert dispatch (server-only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron endpoint auth — set the same value in cron-job.org as Bearer token
CRON_SECRET=generate-a-long-random-string

# Resend — required for availability alert emails
RESEND_API_KEY=re_your_api_key
